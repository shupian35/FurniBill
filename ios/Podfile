# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug'   => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "generated xcconfig file must exist. If you are running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # ----- Workaround for SwiftProtobuf 1.33.x + Swift 5.0 mode -----
  # barcode_scan2 4.7.2 transitively pulls in SwiftProtobuf ~> 1.33, whose
  # generated descriptor.pb.swift / type.pb.swift / wrappers.pb.swift use
  # 'nonisolated let' at file scope. SwiftProtobuf's podspec
  # pins s.swift_version = '5.0', and Swift 5.0 mode rejects that
  # placement.
  # Bump the SwiftProtobuf target to Swift 5.5, the minimum that accepts
  # the generated code. Raise this further if upstream SwiftProtobuf starts
  # requiring a newer Swift version. We cannot downgrade SwiftProtobuf
  # below 1.33 because barcode_scan2 requires it via ~> 1.33.
  installer.pods_project.targets.each do |target|
    if target.name == 'SwiftProtobuf'
      target.build_configurations.each do |config|
        config.build_settings['SWIFT_VERSION'] = '5.5'
      end
    end
  end
end
