# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug'   => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "generated xcconfig file must exist. If you are running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
  
  # ----- Workaround for SwiftProtobuf 1.33.x + Swift 5 mode -----
  # barcode_scan2 4.7.2 transitively pulls in SwiftProtobuf ~> 1.33.
  # The .pb.swift files in that pod (descriptor / type / wrappers / any /
  # api / ...) annotate every file-scope let/var with the 'nonisolated'
  # keyword, which the Swift 5 compiler (Xcode 15.x on macos-14) rejects
  # with:
  #   'nonisolated' modifier cannot be applied to this declaration
  # The file-scope form of 'nonisolated' is Swift 6 only (SE-0431), so
  # simply bumping SWIFT_VERSION to 5.5/5.9/5.10 on the target does not
  # help. We cannot downgrade SwiftProtobuf below 1.33 either, because
  # barcode_scan2 pins it via '~> 1.33'.
  #
  # The fix: after 'pod install' copies SwiftProtobuf into the project,
  # strip the 'nonisolated' keyword from every generated .pb.swift file.
  # In Swift 5 mode, a file-scope let/var is already nonisolated by
  # default, so dropping the keyword is a no-op semantically. We patch
  # the files in-place so Xcode compiles them on the first try.
  swift_protobuf_dir = File.join('Pods', 'SwiftProtobuf', 'Sources', 'SwiftProtobuf')
  if Dir.exist?(swift_protobuf_dir)
    patched_count = 0
    Dir.glob(File.join(swift_protobuf_dir, '*.pb.swift')).each do |file|
      text = File.read(file)
      patched = text.gsub(/nonisolated\s+/, '')
      if patched != text
        File.write(file, patched)
        patched_count += 1
      end
    end
    if patched_count > 0
      Pod::UI.puts "  -> patched #{patched_count} SwiftProtobuf .pb.swift file(s) (stripped nonisolated for Swift 5 mode)"
    end
  end
end
